{
  "name": "desktop-ai-assistant",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "桌面 AI 助手 · 阶段 A/B/C 已完成，阶段 D 部分接入（本地文件与手动截屏预览）",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "tauri": "tauri",
    "dev:desktop": "tauri dev",
    "build:desktop": "tauri build",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint": "npm run typecheck && npm run lint:rust",
    "lint:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "test": "npm run test:contract && npm run test:unit && npm run test:rust",
    "test:contract": "node --test \"tests/contract/**/*.test.mjs\"",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "npm run build && node tests/e2e/ui-flow.check.mjs",
    "test:all": "npm run doctor && npm run lint && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-switch": "^1.4.1",
    "@tauri-apps/api": "^2.12.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
